{
  "name": "bseorogue",
  "description": "블서로그 — 포켓로그(PokeRogue) 코드를 바탕으로 만든 이터널 리턴 2차 창작 로그라이트 웹게임 (AGPL-3.0-only)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SG-pixiv/bseorogue"
  },
  "private": true,
  "version": "1.12.2.3",
  "type": "module",
  "scripts": {
    "start:prod": "vite --mode production",
    "start:dev": "vite --mode development",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "test:profile": "vite-node scripts/profiling/profiling.ts",
    "test:cov": "vitest run --silent='passed-only' --coverage",
    "test:watch": "vitest watch --silent='passed-only'",
    "test:silent": "vitest run --silent='passed-only'",
    "test:merge-reports": "MERGE_REPORTS=1 vitest run --merge-reports=test-results --silent='passed-only' --configLoader runner",
    "test:create": "vite-node scripts/create-test/create-test.ts",
    "decrypt-save": "vite-node scripts/decrypt-save.ts",
    "eggMoves:parse": "vite-node scripts/parse-egg-moves/main.ts",
    "typecheck": "tsc",
    "typecheck:main": "tsc -p scripts/tsconfig.json",
    "typecheck:js": "tsc -p jsconfig.json",
    "biome": "biome check --write --changed --no-errors-on-unmatched --diagnostic-level=error",
    "biome:staged": "biome check --write --staged --no-errors-on-unmatched --diagnostic-level=error",
    "biome:all": "biome check --write --no-errors-on-unmatched --diagnostic-level=error",
    "biome:ci": "biome ci --diagnostic-level=error --reporter=github --reporter=default --no-errors-on-unmatched",
    "typedoc": "typedoc",
    "depcruise": "depcruise src test plugins/phaser plugins/vite",
    "sample-movesets": "vite-node scripts/gen-moveset/gen-moveset-driver.ts",
    "game-data:export": "vitest run --config scripts/game-data-exporter/game-data-exporter.config.ts scripts/game-data-exporter/run.test.ts --",
    "er-data": "node scripts/er-data/fetch.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "ajv": "^8.20.0",
    "core-js": "^3.51.0",
    "crypto-js": "^4.2.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.6",
    "i18next-korean-postposition-processor": "^1.0.0",
    "jszip": "^3.10.2",
    "phaser": "^4.2.1",
    "phaser4-rex-plugins": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commander-js/extra-typings": "^15.0.0",
    "@inquirer/prompts": "^8.7.5",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/expect": "^4.1.12",
    "@vitest/utils": "^4.1.12",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "magic-string": "^1.4.5",
    "msw": "^2.15.0",
    "type-fest": "^5.10.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "unplugin-inline-enum": "0.8.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12",
    "vitest-canvas-mock": "^1.2.0"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@10.34.5"
}
